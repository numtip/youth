---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1.5 text-stone-500">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span aria-hidden="true" class="text-stone-300">/</span>}
          {item.href ? (
            <a href={item.href} class="hover:text-emerald-700 hover:underline">{item.label}</a>
          ) : (
            <span aria-current="page" class="text-stone-800">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

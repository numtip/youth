---
interface Props {
  title: string;
  summary: string;
  href: string;
}

const { title, summary, href } = Astro.props;
---

<article class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md">
  <a href={href} class="group flex flex-col gap-1">
    <h4 class="font-semibold text-stone-900 group-hover:text-emerald-700">{title}</h4>
    <p class="text-sm text-stone-600">{summary}</p>
  </a>
</article>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Gallery from '../Gallery.astro';
import { getLocale, localeHref, ui } from '../../i18n';
import { formatEventDate, localizeEntry } from '../../lib/content';
import { withBase } from '../../lib/site';

interface Props {
  id: string;
}

const { id } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = ui[locale];

const activities = await getCollection('activities');
const activity = activities.find((a) => a.id === id);
if (!activity) {
  return new Response(null, { status: 404 });
}

const { Content } = await render(activity);
const { title, summary } = localizeEntry(locale, activity.data);

const projectHref = localeHref(locale, `activities/${activity.data.year}/${activity.data.project}`);
const crumbs = [
  { label: t.breadcrumbs.home, href: localeHref(locale, '') },
  { label: t.nav.activities, href: localeHref(locale, 'activities') },
  { label: activity.data.project, href: projectHref },
  { label: title },
];

// Some sources point at internal routes as site-absolute paths, which 404 under
// a subpath deploy unless they carry the base. withBase is idempotent, so the
// already-prefixed legacy Joomla paths pass through unchanged.
const sources = [
  ...activity.data.legacyUrls.map((u) => ({ title: u, url: u })),
  ...activity.data.sources,
].map((source) => (source.url.startsWith('/') ? { ...source, url: withBase(source.url) } : source));
---

<BaseLayout title={title} description={summary}>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={crumbs} />

    <article class="mt-6">
      <header>
        <div class="flex flex-wrap items-center gap-2 text-sm text-stone-500">
          <span class="rounded-full bg-emerald-100 px-3 py-1 font-semibold text-emerald-800">
            {t.activities.year} {activity.data.year}
          </span>
          <span>{t.activity.sequence} {activity.data.sequence}</span>
        </div>
        <h1 class="mt-3 text-3xl font-bold text-stone-900">{title}</h1>
        <p class="mt-3 text-stone-700">{summary}</p>
        <p class="mt-2 text-sm text-stone-500">
          {t.activity.date}: <time datetime={activity.data.eventDate.toISOString()}>{formatEventDate(locale, activity.data.eventDate)}</time>
        </p>
        <a href={projectHref} class="mt-4 inline-block text-sm font-medium text-emerald-700 hover:underline">
          ← {t.activity.back}
        </a>
      </header>

      <section class="mt-10">
        <h2 class="text-xl font-bold text-stone-900">{t.activity.details}</h2>
        <div class="md-body mt-4 text-stone-700" lang="th">
          <Content />
        </div>
      </section>

      <section class="mt-10">
        <h2 class="text-xl font-bold text-stone-900">{t.activity.gallery}</h2>
        <div class="mt-4">
          <Gallery images={activity.data.gallery} altBase={title} />
        </div>
      </section>

      {
        sources.length > 0 && (
          <section class="mt-10">
            <h2 class="text-xl font-bold text-stone-900">{t.activity.sources}</h2>
            <ul class="mt-4 list-disc space-y-1 pl-5 text-stone-700">
              {sources.map((source) => (
                <li>
                  <a href={source.url} class="break-all text-emerald-700 hover:underline">{source.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </div>
</BaseLayout>

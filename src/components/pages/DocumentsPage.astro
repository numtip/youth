---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, ui } from '../../i18n';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
---

<BaseLayout title={t.documents.title}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold text-stone-900">{t.documents.title}</h1>
    <p class="mt-2 text-stone-600">{t.documents.subtitle}</p>
    <p class="mt-8 rounded-lg border border-dashed border-stone-300 p-8 text-center text-stone-500">
      {t.documents.empty}
    </p>
  </div>
</BaseLayout>

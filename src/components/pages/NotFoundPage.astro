---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, localeHref, ui } from '../../i18n';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const homeHref = localeHref(locale, '');
---

<BaseLayout title={t.notFound.title}>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <p class="text-6xl font-bold text-emerald-700">404</p>
    <h1 class="mt-4 text-3xl font-bold text-stone-900">{t.notFound.title}</h1>
    <p class="mt-3 text-stone-600">{t.notFound.message}</p>
    <a
      href={homeHref}
      class="mt-8 inline-block rounded-lg bg-emerald-700 px-5 py-3 font-semibold text-white transition-colors hover:bg-emerald-800"
    >
      {t.notFound.back}
    </a>
  </div>
</BaseLayout>

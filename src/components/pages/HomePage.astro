---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../ProjectCard.astro';
import { getLocale, localeHref, ui } from '../../i18n';
import { getPublishedProjects, localizeEntry } from '../../lib/content';
import { withBase } from '../../lib/site';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const projects = await getPublishedProjects();
const activitiesHref = localeHref(locale, 'activities');
const heroImg = withBase('/media/brand/hero-banner.jpg');
---

<BaseLayout>
  <section class="relative overflow-hidden bg-emerald-800 text-white">
    <img
      src={heroImg}
      alt=""
      aria-hidden="true"
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover object-center opacity-40"
    />
    <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
      <p class="mb-3 text-sm font-medium text-emerald-200">{t.siteTagline}</p>
      <h1 class="max-w-2xl text-3xl font-bold leading-tight drop-shadow-md sm:text-4xl">{t.hero.title}</h1>
      <p class="mt-4 max-w-2xl text-emerald-50 drop-shadow">{t.hero.subtitle}</p>
      <a
        href={activitiesHref}
        class="mt-8 inline-block rounded-lg bg-white px-5 py-3 font-semibold text-emerald-800 transition-colors hover:bg-emerald-50"
      >
        {t.hero.cta}
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-stone-900">{t.home.latest}</h2>
      <a href={activitiesHref} class="text-sm font-medium text-emerald-700 hover:underline">
        {t.home.viewAll} →
      </a>
    </div>

    {
      projects.length === 0 ? (
        <p class="rounded-lg border border-dashed border-stone-300 p-8 text-center text-stone-500">{t.home.empty}</p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => {
            const { title, summary } = localizeEntry(locale, project.data);
            return (
              <ProjectCard
                title={title}
                summary={summary}
                cover={project.data.cover}
                alt={title}
                year={project.data.year}
                href={localeHref(locale, `activities/${project.data.year}/${project.data.slug}`)}
              />
            );
          })}
        </div>
      )
    }
  </section>
</BaseLayout>

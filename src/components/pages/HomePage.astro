---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../Hero.astro';
import ImpactStrip from '../ImpactStrip.astro';
import FeaturedStories from '../FeaturedStories.astro';
import ProjectCard from '../ProjectCard.astro';
import { getLocale, localeHref, ui } from '../../i18n';
import { getImpactTotals, getPublishedProjects, localizeEntry } from '../../lib/content';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const projects = await getPublishedProjects();
const totals = await getImpactTotals();
const activitiesHref = localeHref(locale, 'activities');

const chips = [
  { value: totals.projects, label: t.home.impact.projects },
  { value: totals.activities, label: t.home.impact.activities },
  { value: totals.years, label: t.home.impact.years },
];
---

<BaseLayout>
  <Hero
    title={t.hero.title}
    tagline={t.siteTagline}
    subtitle={t.hero.subtitle}
    ctaLabel={t.hero.cta}
    ctaHref={activitiesHref}
    chips={chips}
  />

  <ImpactStrip totals={totals} labels={t.home.impact} />

  <FeaturedStories />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-stone-900">{t.home.latest}</h2>
      <a href={activitiesHref} class="text-sm font-medium text-emerald-700 hover:underline">
        {t.home.viewAll} →
      </a>
    </div>

    {
      projects.length === 0 ? (
        <p class="rounded-lg border border-dashed border-stone-300 p-8 text-center text-stone-500">{t.home.empty}</p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => {
            const { title, summary } = localizeEntry(locale, project.data);
            return (
              <ProjectCard
                title={title}
                summary={summary}
                cover={project.data.cover}
                alt={title}
                year={project.data.year}
                href={localeHref(locale, `activities/${project.data.year}/${project.data.slug}`)}
              />
            );
          })}
        </div>
      )
    }
  </section>
</BaseLayout>

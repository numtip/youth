---
import MediaFigure from './MediaFigure.astro';

interface Props {
  title: string;
  summary: string;
  cover: string;
  alt: string;
  year: number;
  href: string;
  featured?: boolean;
}

const { title, summary, cover, alt, year, href, featured = false } = Astro.props;
---

<article class="group flex h-full flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md">
  <a href={href} class="card-link flex h-full flex-col">
    <MediaFigure src={cover} alt={alt} aspect={featured ? '16/9' : '4/3'} />
    <div class:list={['flex flex-1 flex-col gap-2', featured ? 'p-5 sm:p-6' : 'p-4']}>
      <div class="flex items-center gap-2">
        <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-800">{year}</span>
      </div>
      <h3
        class:list={[
          'font-semibold text-stone-900 group-hover:text-emerald-700',
          featured ? 'text-lg sm:text-xl' : 'text-base',
        ]}
      >
        {title}
      </h3>
      <p class="text-sm leading-relaxed text-stone-600">{summary}</p>
      <span class="mt-auto pt-2 text-sm font-medium text-emerald-700">→</span>
    </div>
  </a>
</article>
